<?xml version="1.0"?>
<phpunit
	bootstrap="tests/php/bootstrap.php"
	backupGlobals="false"
	colors="true"
>
	<testsuites>
		<testsuite name="rawmark">
			<!--
				suffix, not prefix. `prefix="Test"` required filenames to
				*start* with Test; every file here is <Thing>Test.php, so
				bare `vendor/bin/phpunit` discovered nothing and reported
				"No tests executed!" while exiting 0.
			-->
			<directory suffix="Test.php">./tests/php/</directory>
		</testsuite>
	</testsuites>
</phpunit>
